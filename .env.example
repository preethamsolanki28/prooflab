# ResearchMesh / Gardenia 2K26 — Environment Configuration Template
# Copy this file to .env.local and configure with your production credentials.
# NEVER commit .env.local or real API keys to version control.

# ==============================================================================
# Supabase Configuration (Hosted Production Supabase Project)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Optional: PostgreSQL Direct Connection for CLI migrations / test runners
DATABASE_URL=postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres

# ==============================================================================
# AI Provider Configuration (Public vs Confidential Routing)
# ==============================================================================
# Public Research Model (OpenRouter GPT-4o-mini)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# On-Device / Local AI Model (Ollama — for Confidential / Mixed data)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=smollm2:135m

# ==============================================================================
# Workspace Service Configuration (code-server Browser IDE)
# ==============================================================================
# URL of the deployed code-server reverse proxy instance
WORKSPACE_SERVICE_URL=
WORKSPACE_PASSWORD=
